[TEMPLATE]
# Copy to .env to enable features. Ascend runs without it (built-in curator + demo profile).
# Never commit .env — it holds real credentials.

# ── Google sign-in (the ONLY login option) ──────────────────────────────
# Create OAuth credentials at Google Cloud Console → APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application.
# Authorized redirect URI must match exactly:
#   http://localhost:4637/api/auth/google/callback
# (use your actual port; ASCEND_BASE_URL overrides the host when deployed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ASCEND_BASE_URL=http://localhost:4637

# ── Optional: connect a real LLM (works without it — built-in curator) ──
# Any OpenAI-compatible endpoint works: OpenAI, Groq, DeepSeek, Ollama, LM Studio…
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: server port (default 4637; the shell may already export PORT)
# PORT=4637
